        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last import",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pulse"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(\n  (SELECT to_char(finished_at AT TIME ZONE 'Europe/Rome', 'YYYY-MM-DD HH24:MI') || ' · ' || status\n   FROM import_run WHERE game = '$game' ORDER BY id DESC LIMIT 1), 'never') AS \"Last import\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
