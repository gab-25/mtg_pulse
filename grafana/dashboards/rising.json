            "uid": "pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Cards tracked daily\"\nFROM price\nWHERE game = '$game' AND day = (SELECT max(day) FROM price WHERE game = '$game')"
