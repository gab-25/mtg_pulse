    {
      "id": 7,
      "type": "table",
      "title": "Latest daily changes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tcg_pulse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tcg_pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT day AS \"Date\", trend AS \"Trend\", trend - prev AS \"Change\", (trend - prev) / nullif(prev, 0) AS \"Change %\"\nFROM (\n  SELECT day, trend, lag(trend) OVER (ORDER BY day) AS prev\n  FROM price\n  WHERE game = '$game' AND id_product = nullif('$card', '')::int AND trend IS NOT NULL\n) d\nORDER BY day DESC\nLIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {
