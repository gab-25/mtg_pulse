      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tcg_pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT day, trend FROM price WHERE game = '$game' AND id_product = nullif('$card', '')::int AND trend IS NOT NULL ORDER BY day DESC LIMIT 1\n)\nSELECT (l.trend - p.trend) / nullif(p.trend, 0) AS \"Change 7 days\"\nFROM latest l\nCROSS JOIN LATERAL (\n  SELECT trend FROM price\n  WHERE game = '$game' AND id_product = nullif('$card', '')::int AND trend IS NOT NULL AND day <= l.day - 7\n  ORDER BY day DESC\n  LIMIT 1\n) p"
        }
      ],
