      {
        "name": "card",
        "label": "Card",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tcg_pulse"
        },
        "query": {
          "refId": "card",
          "rawSql": "SELECT label || CASE WHEN count(*) OVER (PARTITION BY label) > 1 THEN ' · #' || id_product ELSE '' END AS __text,\n       id_product AS __value\nFROM (\n  SELECT c.name || coalesce(' · ' || coalesce(e.name, '#' || c.id_expansion), '') AS label, c.id_product\n  FROM card c\n  LEFT JOIN expansion e ON e.game = c.game AND e.id_expansion = c.id_expansion\n  WHERE c.game = '$game'\n    AND (strpos(lower(c.name), lower(${search:sqlstring})) > 0 OR c.id_product = nullif('$card', '')::int)\n) cards\nORDER BY 1, 2\nLIMIT 200",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true
        },
        "definition": "SELECT label || CASE WHEN count(*) OVER (PARTITION BY label) > 1 THEN ' · #' || id_product ELSE '' END AS __text,\n       id_product AS __value\nFROM (\n  SELECT c.name || coalesce(' · ' || coalesce(e.name, '#' || c.id_expansion), '') AS label, c.id_product\n  FROM card c\n  LEFT JOIN expansion e ON e.game = c.game AND e.id_expansion = c.id_expansion\n  WHERE c.game = '$game'\n    AND (strpos(lower(c.name), lower(${search:sqlstring})) > 0 OR c.id_product = nullif('$card', '')::int)\n) cards\nORDER BY 1, 2\nLIMIT 200",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
