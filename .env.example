# Database (docker compose). Generate passwords with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=tcg_pulse
# Read-only role Grafana uses to query the database.
PULSE_DB_READER_PASSWORD=change-me

# Grafana login (the only account; anonymous access and sign-up are off).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Running the sync outside docker compose:
# DATABASE_URL=postgresql://tcg_pulse:tcg_pulse@localhost:5432/tcg_pulse
# DATA_DIR=data
